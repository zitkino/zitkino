{# Define cinema list macros #}

{% macro cinemaList(cinema) %}
    {% if cinema is defined %}
        <li class="list-group-item">
            {{ _self.cinemaListContent(cinema) }}
        </li>
    {% endif %}
{% endmacro %}

{% macro cinemaListContent(cinema) %}
    <strong>{{ cinema.name }}</strong>
    <div class="float-right">
        <a href="{{ path('cinema_profile', {'id': cinema.code}) }}"><i class="far fa-list-alt fa-lg"></i> profil kina</a>
    </div>

    <ul class="list-inline">
        <li class="list-inline-item">
            {% set address = cinema.address ~ ", " ~ cinema.city %}
            <a href="https://www.google.cz/maps/place/{{ address|url_encode }}"><i class="fas fa-map-marker-alt"></i> {{ address }}</a>
        </li>
        <li class="list-inline-item">
            {% set url = cinema.url %}
            <a href="{{ url }}"><i class="fas fa-link"></i> {{ url }}</a>
        </li>
    </ul>
{% endmacro %}

{% macro cinemaMovieList(cinemas) %}
    {% if cinemas is empty %}
        <p>Dnes nepromítají žádná kina.</p>
    {% else %}
        {% for cinemaItem in cinemas %}
            {% set screenings = cinemaItem.soonestScreenings %}
            <section class="card card-default">
                <header class="card-header" data-toggle="collapse" data-target="#{{ cinemaItem.code }}">
                    {{ _self.cinemaListContent(cinemaItem) }}
                </header>

                <article id="{{ cinemaItem.code }}" class="card-body collapse show">
                    {{ _self.movieList(screenings, cinemaItem) }}
                </article>
            </section>
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro movieList(screenings, cinema) %}
    {% if screenings is null or screenings.empty %}
        <p>Dnes kino asi nepromítá. &#9785;</p>
        <p>Program na další dny je na webu kina: <a href="{{ cinema.programme }}" title="Program na webu kina.">{{ cinema.programme }}</a></p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-sm">
                <thead>
                    <tr>
                        <th>
                            <abbr title="Film"><i class="fas fa-film"></i></abbr> <span class="d-none d-sm-none d-md-inline">Film</span>
                        </th>

                        {% if screenings.hasTypes() %}
                        <th>
                            <abbr title="Typ filmu"><i class="fas fa-video"></i></abbr> <span class="d-none d-sm-none d-md-inline">Typ</span>
                        </th>
                        {% endif %}

                        <th>
                            <abbr title="Promítání"><i class="far fa-calendar-alt"></i></abbr> <span class="d-none d-sm-none d-md-inline">Promítání</span>
                        </th>

                        {% if screenings.hasPlaces() %}
                        <th>
                            <abbr title="Místa"><i class="fas fa-warehouse"></i></abbr> <span class="d-none d-sm-none d-md-inline">Místo</span>
                        </th>
                        {% endif %}

                        {% if screenings.hasLanguages() %}
                        <th>
                            <abbr title="Dabing"><i class="fas fa-headphones"></i></abbr> <span class="d-none d-sm-none d-md-inline">Dabing</span> a <abbr title="Titulky"><i class="fas fa-paragraph"></i></abbr>
                            <span class="d-none d-sm-none d-md-inline">titulky</span>
                        </th>
                        {% endif %}

                        {% if screenings.movies.hasLengths() %}
                        <th>
                            <abbr title="Délka"><i class="fas fa-hourglass-end"></i></abbr> <span class="d-none d-sm-none d-md-inline">Délka</span>
                        </th>
                        {% endif %}

                        {% if screenings.hasPrices() %}
                        <th>
                            <abbr title="Cena"><i class="far fa-money-bill-alt"></i></abbr> <span class="d-none d-sm-none d-md-inline">Cena</span>
                        </th>
                        {% endif %}

                        <th>
                            <abbr title="Filmové databáze"><i class="fas fa-database"></i></abbr> <span class="d-none d-sm-none d-md-inline">Databáze</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for screening in screenings %}
                        <td title="Název filmu">
                            {% set link = screening.link %}
                            {% if link is defined %}<a href="{{ link }}">{% endif %}
                                {{ screening.movie.name }}
                            {% if link is defined %}</a>{% endif %}
                        </td>

                        {% if screenings.hasTypes() %}
                        <td title="Typ filmu">
                            {% if screening.type is not empty and screening.type.code != "2D" %}
                                <span class="badge badge-type" title="Typ">{{ screening.type.name }}</span>
                            {% endif %}
                        </td>
                        {% endif %}

                        <td title="Datum a čas">
                            {% if screening.showtimes is not empty %}
                                <i class="far fa-calendar"></i> 
                                {% for showtime in screening.showtimes %}
                                    {% if loop.first %}
                                        {{ showtime.datetime|date('d.m.Y') }} <br class="d-md-none d-lg-none"><i class="far fa-clock"></i>
                                    {% endif %}
                                    {{ showtime.datetime|date('H:i') }}{% if not loop.last %}, {% endif %}
                                {% endfor %}
                            {% endif %}
                        </td>

                        {% if screenings.hasPlaces() %}
                        <td title="Místo">
                            {% set place = screening.place %}
                            {% if place is defined %}
                                {% set placeLink = place.link %}
                                {% if placeLink is defined %}<a href="{{ placeLink }}">{% endif %}
                                {{ place.name|trim }}
                                {% if placeLink is defined %}</a>{% endif %}
                            {% endif %}
                        </td>
                        {% endif %}

                        {% if screenings.hasLanguages() %}
                        <td title="Jazyk">
                            {% set dubbing = screening.dubbing %}
                            {% if dubbing is defined %}
                                <span class="badge badge-language" title="Dabing"><i class="fas fa-headphones"></i>&nbsp;{{ dubbing }}</span>
                            {% endif %}
                            <br class="d-md-none d-lg-none">
                            {% set subtitles = screening.subtitles %}
                            {% if subtitles is defined %}
                                <span class="badge badge-subtitles" title="Titulky"><i class="fas fa-paragraph"></i>&nbsp;{{ subtitles }}</span>
                            {% endif %}
                        </td>
                        {% endif %}

                        {% if screenings.movies.hasLengths() %}
                        <td title="Délka">
                            {% set length = screening.movie.length %}
                            {% if length is defined %}{{ length|trim }} min.{% endif %}
                        </td>
                        {% endif %}

                        {% if screenings.hasPrices() %}
                        <td title="Cena">
                            {% set price = screening.fixPrice %}
                            {% if price is defined %}{{ price|trim }}{% endif %}
                        </td>
                        {% endif %}

                        <td title="Databáze">
                            {% set databases = screening.movie.databases %}
                            <a href="{{ databases['csfd'] }}" title="ČSFD"> <img src="{{ asset('img/csfd.svg') }}" width="20" alt="ČSFD"> </a> <br class="d-md-none d-lg-none">
                            <a href="{{ databases['imdb'] }}" title="IMDb"><i class="fab fa-imdb fa-lg"></i></a>
                        </td>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if app.request.pathInfo == '/' ~ cinema.code %}
            <p>Další program a podrobné informace o filmech: <a href="{{ cinema.programme }}" title="Program na webu kina.">{{ cinema.programme }}</a></p>
        {% endif %}
    {% endif %}
{% endmacro %}

{
	"name": "zitkino/zitkino",
	"description": "Brno's cinemas",
	"type": "project",
	"config": {
		"vendor-dir": "vendor",
		"platform-check": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"optimize-autoloader": true,
		"allow-plugins": {
			"php-http/discovery": true,
			"symfony/flex": true,
			"symfony/runtime": true
		}
	},
	"scripts": {
		"pre-install-cmd": [
			"composer check-platform-reqs"
		],
		"pre-update-cmd": [
			"composer self-update"
		],
		"fixer": [
			"vendor/bin/php-cs-fixer fix --diff --dry-run -v --config fixer.php"
		],
		"fixer-run": [
			"vendor/bin/php-cs-fixer fix --diff --config fixer.php"
		],
		"phpstan": [
			"vendor/bin/phpstan analyse src -c phpstan.neon"
		],
		"phpstan-baseline": [
			"vendor/bin/phpstan analyse src -c phpstan.neon --generate-baseline"
		],
		"auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd"
		},
		"post-install-cmd": [
			"@auto-scripts"
		],
		"post-update-cmd": [
			"@auto-scripts"
		]
	},
	"require": {
		"php": "^7.3",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-libxml": "*",
		"doctrine/annotations": "^1.0",
		"doctrine/doctrine-bundle": "^2.5",
		"doctrine/doctrine-migrations-bundle": "^3.2",
		"doctrine/orm": "^2.10",
		"johngrogg/ics-parser": "^2.1",
		"sensio/framework-extra-bundle": "^6.2",
		"sentry/sentry-symfony": "^4.2",
		"symfony/asset": "5.4.*",
		"symfony/console": "5.4.*",
		"symfony/dotenv": "5.4.*",
		"symfony/flex": "^1.17",
		"symfony/form": "5.4.*",
		"symfony/framework-bundle": "5.4.*",
		"symfony/http-client": "5.4.*",
		"symfony/monolog-bundle": "^3.7",
		"symfony/runtime": "5.4.*",
		"symfony/security-bundle": "5.4.*",
		"symfony/translation": "5.4.*",
		"symfony/twig-bundle": "5.4.*",
		"symfony/validator": "5.4.*",
		"symfony/yaml": "5.4.*",
		"twig/extra-bundle": "^2.12|^3.0",
		"twig/twig": "^2.12|^3.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.4",
		"phpstan/phpstan": "^1.7",
		"phpstan/phpstan-doctrine": "^1.3",
		"phpstan/phpstan-symfony": "^1.1",
		"symfony/debug-bundle": "5.4.*",
		"symfony/maker-bundle": "^1.36",
		"symfony/stopwatch": "5.4.*",
		"symfony/web-profiler-bundle": "5.4.*"
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	},
	"replace": {
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-iconv": "*",
		"symfony/polyfill-php72": "*"
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"extra": {
		"symfony": {
			"allow-contrib": false,
			"require": "5.4.*"
		}
	}
}

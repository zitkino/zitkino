{
	"name": "zitkino/zitkino",
	"description": "Brno's cinemas",
	"type": "project",
	"minimum-stability": "stable",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"php-http/discovery": true,
			"symfony/flex": true,
			"symfony/runtime": true
		},
		"bump-after-update": true,
		"platform-check": true,
		"preferred-install": "dist",
		"sort-packages": true,
		"optimize-autoloader": true,
		"process-timeout": 3000
	},
	"scripts": {
		"auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd",
			"importmap:install": "symfony-cmd",
			"sass:build": "symfony-cmd"
		},
		"pre-install-cmd": [
			"composer check-platform-reqs"
		],
		"post-install-cmd": [
			"@auto-scripts"
		],
		"post-update-cmd": [
			"@auto-scripts"
		],
		"fixer": [
			"vendor/bin/php-cs-fixer fix --diff --dry-run -v --config fixer.php"
		],
		"fixer-run": [
			"vendor/bin/php-cs-fixer fix --diff --config fixer.php"
		],
		"phpstan": [
			"vendor/bin/phpstan analyse app -c app/config/phpstan.neon"
		],
		"phpstan-baseline": [
			"vendor/bin/phpstan analyse app -c app/config/phpstan.neon --generate-baseline"
		],
		"translations": [
			"php bin/console translation:extract --force --format=yaml --as-tree=4 --sort=asc cs && php bin/console translation:extract --force --format=yaml --as-tree=4 --sort=asc en"
		],
		"routes": [
			"php bin/console debug:router"
		]
	},
	"repositories": [
		{
			"type": "path",
			"url": "./dobine",
			"options": {
				"symlink": true
			}
		},
		{
			"type": "path",
			"url": "./booty",
			"options": {
				"symlink": true
			}
		}
	],
	"require": {
		"php": "8.4.*",
		"ext-ctype": "*",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-iconv": "*",
		"ext-libxml": "*",
		"ext-pdo_sqlite": "*",
		"a2lix/translation-form-bundle": "^3.2",
		"doctrine/dbal": "^3.10.2",
		"doctrine/doctrine-bundle": "^2.16.2",
		"doctrine/doctrine-migrations-bundle": "^3.4.2",
		"doctrine/orm": "^3.6",
		"easycorp/easyadmin-bundle": "^4.25.1",
		"emileperron/tinymce-bundle": "^3.3",
		"guzzlehttp/guzzle": "^7.10",
		"hermajan/booty": "dev-master",
		"hermajan/dobine": "dev-main",
		"hermajan/facolors": "^1.0",
		"johngrogg/ics-parser": "^3.4.1",
		"knplabs/doctrine-behaviors": "^3.0",
		"league/commonmark": "^2.7.1",
		"symfony/apache-pack": "^1.0.1",
		"symfony/asset": "7.3.*",
		"symfony/asset-mapper": "7.3.*",
		"symfony/console": "^7.3.4",
		"symfony/dotenv": "^7.3.2",
		"symfony/expression-language": "^7.3.2",
		"symfony/flex": "^2.8.2",
		"symfony/form": "^7.3.4",
		"symfony/framework-bundle": "^7.3.4",
		"symfony/html-sanitizer": "^7.3.3",
		"symfony/http-client": "^7.3.4",
		"symfony/intl": "^7.3.4",
		"symfony/mailer": "^7.3.4",
		"symfony/monolog-bundle": "^3.10",
		"symfony/polyfill-intl-messageformatter": "^1.33",
		"symfony/runtime": "^7.3.4",
		"symfony/security-bundle": "^7.3.4",
		"symfony/string": "^7.3.4",
		"symfony/translation": "^7.3.4",
		"symfony/twig-bundle": "^7.3.4",
		"symfony/ux-icons": "^2.31",
		"symfony/validator": "^7.3.4",
		"symfony/yaml": "^7.3.3",
		"symfonycasts/sass-bundle": "^0.9.0",
		"symfonycasts/verify-email-bundle": "^1.18",
		"twbs/bootstrap-icons": "^1.13",
		"twig/extra-bundle": "^3.21",
		"twig/intl-extra": "^3.21",
		"twig/markdown-extra": "^3.21",
		"twig/twig": "^2.12|^3.0"
	},
	"require-dev": {
		"dama/doctrine-test-bundle": "^8.3.1",
		"doctrine/doctrine-fixtures-bundle": "^3.7.1",
		"phpstan/phpstan": "^2.1.30",
		"phpstan/phpstan-doctrine": "^2.0.6",
		"phpstan/phpstan-symfony": "^2.0.8",
		"phpunit/phpunit": "^11.5.42",
		"symfony/browser-kit": "^7.3.2",
		"symfony/css-selector": "^7.3",
		"symfony/debug-bundle": "^7.3.4",
		"symfony/maker-bundle": "^1.64",
		"symfony/stopwatch": "^7.3",
		"symfony/web-profiler-bundle": "^7.3.4",
		"twbs/bootstrap": "^5.3.8"
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	},
	"replace": {
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-iconv": "*",
		"symfony/polyfill-php72": "*",
		"symfony/polyfill-php73": "*",
		"symfony/polyfill-php74": "*",
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php81": "*",
		"symfony/polyfill-php82": "*"
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"extra": {
		"symfony": {
			"allow-contrib": true
		}
	}
}

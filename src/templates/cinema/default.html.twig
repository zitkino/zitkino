{% extends 'base.html.twig' %}

{% block title %}{{ "cinemas.default.title"|trans }}{% endblock %}

{% block content %}
	{% for type in types %}
		<h2>
			<a href="{{ path('cinema_type_'~ type.ident, {'slug': type.translation.slug}) }}">{{ type.translation.title }}</a>
			<small class="float-end"><a href="{{ path('cinema_programme_' ~ type.ident) }}">{% if type.icon %}{{ type.iconTag|raw }}{% else %}<span>🎥</span>{% endif %}</a></small>
		</h2>
		<ul class="list-group">
			{% from 'cinema/list.html.twig' import cinemaList %}
			{% for cinemaItem in type.cinemas %}
				{{ cinemaList(cinemaItem) }}
			{% endfor %}
		</ul>
	{% endfor %}
{% endblock %}

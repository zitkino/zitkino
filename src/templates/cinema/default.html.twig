{% extends 'base.html.twig' %}

{% block title %}Brněnská kina{% endblock %}

{% block content %}
<h1 class="page-header">{{ block('title') }}</h1>

<h2><a href="{{ path('cinema_type_classic') }}">Klasická kina</a> <span class="float-right"><small><a href="{{ path('cinema_programme_classic') }}"><i class="far fa-building"></i></a></small></span></h2>
<ul class="list-group">
    {% from 'cinema/list.html.twig' import cinemaList %}
    {% for cinemaItem in classicCinemas %}
        {{ cinemaList(cinemaItem) }}
    {% endfor %}
</ul>

<h2><a href="{{ path('cinema_type_multiplex') }}">Multiplexy</a> <span class="float-right"><small><a href="{{ path('cinema_programme_multiplex') }}"><i class="fas fa-building"></i></a></small></span></h2>
<ul class="list-group">
    {% for cinemaItem in multiplexCinemas %}
        {{ cinemaList(cinemaItem) }}
    {% endfor %}
</ul>

<h2><a href="{{ path('cinema_type_summer') }}">Letní kina</a> <span class="float-right"><small><a href="{{ path('cinema_programme_summer') }}"><i class="far fa-sun"></i></a></small></span></h2>
<ul class="list-group">
    {% for cinemaItem in summerCinemas %}
        {{ cinemaList(cinemaItem) }}
    {% endfor %}
</ul>
{% endblock %}

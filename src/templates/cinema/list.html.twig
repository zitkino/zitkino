{# Define cinema list macros #}

{% macro cinemaList(cinema) %}
	{% if cinema is defined %}
		<li class="list-group-item">
			{{ _self.cinemaListContent(cinema) }}
		</li>
	{% endif %}
{% endmacro %}

{% macro cinemaListContent(cinema) %}
	<strong>{{ cinema.name }}</strong>
	<div class="float-right">
		<a href="{{ path('cinema_profile', {'id': cinema.code}) }}">{{ "cinemas.profile"|trans }} <i class="bi bi-caret-right"></i></a>
	</div>

	<ul class="list-inline">
		<li class="list-inline-item">
			{% set address = cinema.address ~ ", " ~ cinema.city %}
			<a href="https://www.google.cz/maps/place/{{ address|url_encode }}"><i class="bi bi-geo-alt"></i> {{ address }}</a>
		</li>
		<li class="list-inline-item">
			{% set url = cinema.url %}
			<a href="{{ url }}"><i class="bi bi-link"></i> {{ url }}</a>
		</li>
	</ul>
{% endmacro %}

{% macro cinemaMovieList(cinemas) %}
	{% if cinemas is empty %}
		<p>{{ "screenings.empty.todays"|trans }}</p>
	{% else %}
		{% for cinemaItem in cinemas %}
			{% set screenings = cinemaItem.soonestScreenings %}
			<section class="card card-default">
				<header class="card-header" data-toggle="collapse" data-target="#{{ cinemaItem.code }}">
					{{ _self.cinemaListContent(cinemaItem) }}
				</header>

				<article id="{{ cinemaItem.code }}" class="card-body collapse show">
					{{ _self.movieList(screenings, cinemaItem) }}
				</article>
			</section>
		{% endfor %}
	{% endif %}
{% endmacro %}

{% macro movieList(screenings, cinema) %}
	{% if screenings is null or screenings.empty %}
		<p>{{ "screenings.empty.today"|trans|raw }}</p>
		<p>{{ "cinemas.programme.web.next"|trans }}: <a href="{{ cinema.programme }}" title="{{ "cinemas.programme.web.title"|trans }}">{{ cinema.programme }}</a></p>
	{% else %}
		<div class="table-responsive">
			<table class="table table-hover table-sm">
				<thead>
				<tr>
					<th>
						<abbr title="{{ "details.movie.long"|trans }}"><i class="bi bi-film"></i></abbr> <span class="d-none d-sm-none d-md-inline">{{ "details.movie.short"|trans }}</span>
					</th>

					{% if screenings.hasTypes() %}
						<th>
							<abbr title="{{ "details.type.long"|trans }}"><i class="bi bi-camera-video"></i></abbr> <span class="d-none d-sm-none d-md-inline">{{ "details.type.short"|trans }}</span>
						</th>
					{% endif %}

					<th>
						<abbr title="{{ "details.showtime.long"|trans }}"><i class="bi bi-calendar2-week-alt"></i></abbr> <span
							class="d-none d-sm-none d-md-inline">{{ "details.showtime.short"|trans }}</span>
					</th>

					{% if screenings.hasPlaces() %}
						<th>
							<abbr title="{{ "details.place.long"|trans }}"><i class="bi bi-door-open"></i></abbr> <span class="d-none d-sm-none d-md-inline">{{ "details.place.short"|trans }}</span>
						</th>
					{% endif %}

					{% if screenings.hasLanguages() %}
						<th>
							<abbr title="{{ "details.dabing.long"|trans }}"><i class="bi bi-headphones"></i></abbr>&nbsp;<span class="d-none d-sm-none d-md-inline">{{ "details.dabing.short"|trans }}</span> a <abbr title="{{ "details.subtitles.long"|trans }}"><i class="bi bi-paragraph"></i></abbr>&nbsp;<span class="d-none d-sm-none d-md-inline">{{ "details.subtitles.short"|trans }}</span>
						</th>
					{% endif %}

					{% if screenings.movies.hasLengths() %}
						<th>
							<abbr title="{{ "details.length.long"|trans }}"><i class="bi bi-hourglass-split"></i></abbr> <span
								class="d-none d-sm-none d-md-inline">{{ "details.length.short"|trans }}</span>
						</th>
					{% endif %}

					{% if screenings.hasPrices() %}
						<th>
							<abbr title="{{ "details.price.long"|trans }}"><i class="bi bi-cash"></i></abbr> <span
								class="d-none d-sm-none d-md-inline">{{ "details.price.short"|trans }}</span>
						</th>
					{% endif %}

					<th>
						<abbr title="{{ "details.database.long"|trans }}"><i class="bi bi-database"></i></abbr> <span class="d-none d-sm-none d-md-inline">{{ "details.database.short"|trans }}</span>
					</th>
				</tr>
				</thead>
				<tbody>
				{% for screening in screenings %}
					<tr>
						<td title="{{ "details.movie.long"|trans }}">
							{% set link = screening.link %}
							{% if link is defined %}<a href="{{ link }}">{% endif %}{{ screening.movie.name }}{% if link is defined %}</a>{% endif %}
						</td>

						{% if screenings.hasTypes() %}
							<td title="{{ "details.type.long"|trans }}">
								{% if screening.type is not empty and screening.type.code != "2D" %}
									<span class="badge badge-type" title="Typ">{{ screening.type.name }}</span>
								{% endif %}
							</td>
						{% endif %}

						<td title="{{ "details.showtime.long"|trans }}">
							{% if screening.showtimes is not empty %}
								<i class="bi bi-calendar2-week"></i>
								{% for showtime in screening.showtimes %}
									{% if loop.first %}
										{{ showtime.datetime|date('d.m.Y') }} <br class="d-md-none d-lg-none"><i class="bi bi-clock"></i>
									{% endif %}
									{{ showtime.datetime|date('H:i') }}{% if not loop.last %}, {% endif %}
								{% endfor %}
							{% endif %}
						</td>

						{% if screenings.hasPlaces() %}
							<td title="{{ "details.place.long"|trans }}">
								{% set place = screening.place %}
								{% if place is defined %}
									{% set placeLink = place.link %}
									{% if placeLink is defined %}<a href="{{ placeLink }}">{% endif %}
									{{ place.name|trim }}
									{% if placeLink is defined %}</a>{% endif %}
								{% endif %}
							</td>
						{% endif %}

						{% if screenings.hasLanguages() %}
							<td title="{{ "details.language.long"|trans }}">
								{% if screening.dubbing is not empty %}
									<span class="badge badge-language" title="{{ "details.dabing.long"|trans }}"><i class="bi bi-headphones"></i>&nbsp;{{ screening.dubbing }}</span>
								{% endif %}
								<br class="d-md-none d-lg-none">
								{% if screening.subtitles is not empty %}
									<span class="badge badge-subtitles" title="{{ "details.subtitles.long"|trans }}"><i class="bi bi-paragraph"></i>&nbsp;{{ screening.subtitles }}</span>
								{% endif %}
							</td>
						{% endif %}

						{% if screenings.movies.hasLengths() %}
							<td title="{{ "details.length.long"|trans }}">
								{% if screening.movie.length is not empty %}{{ screening.movie.length|trim }} min.{% endif %}
							</td>
						{% endif %}

						{% if screenings.hasPrices() %}
							<td title="{{ "details.price.long"|trans }}">
								{% if screening.fixPrice is not empty %}{{ screening.fixPrice|trim }}{% endif %}
							</td>
						{% endif %}

						<td title="{{ "details.database.long"|trans }}">
							{% set databases = screening.movie.databases %}
							<a href="{{ databases['csfd'] }}" title="ČSFD"> <img src="{{ asset('img/csfd.svg') }}" width="20" alt="ČSFD"> </a> <br class="d-md-none d-lg-none">
							<a href="{{ databases['imdb'] }}" title="IMDb"><i class="fab fa-imdb fa-lg"></i></a>
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
		</div>

		{% if app.request.pathInfo == '/' ~ cinema.code %}
			<p>{{ "cinemas.programme.web.info"|trans }}: <a href="{{ cinema.programme }}" title="{{ "cinemas.programme.web.title"|trans }}">{{ cinema.programme }}</a></p>
		{% endif %}
	{% endif %}
{% endmacro %}

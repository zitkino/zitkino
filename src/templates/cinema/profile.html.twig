{% extends 'base.html.twig' %}

{% block title %}{{ cinema.name }}{% endblock %}

{% block content %}
	<h1 class="page-header">{{ block('title') }}</h1>
	{% from 'cinema/list.html.twig' import movieList %}

	{{ movieList(screenings, cinema) }}

	<div>
		<div class="float-right">
			<a href="{{ cinema.programme }}" title="Program na webu kina."><i class="fas fa-book"></i> podrobný program</a><br>

			<span class="float-right">
			{% set facebook = cinema.facebook %}
				{% if facebook is defined %}
					<a href="https://www.facebook.com/{{ facebook }}"><i class="fab fa-facebook fa-2x"></i></a>
				{% endif %}

				{# {% set googlePlus = cinema.googlePlus %} #}
				{# {% if googlePlus is defined %} #}
				{#     <a href="https://plus.google.com/{{ googlePlus }}"><i class="fab fa-google-plus-g fa-2x"></i></a> #}
				{# {% endif %} #}

				{% set instagram = cinema.instagram %}
				{% if instagram is defined %}
					<a href="https://www.instagram.com/{{ instagram }}"><i class="fab fa-instagram fa-2x"></i></a>
				{% endif %}

				{# {% set twitter = cinema.twitter %} #}
				{# {% if twitter is defined %} #}
				{#     <a href="https://twitter.com/{{ twitter }}"><i class="fab fa-twitter fa-2x"></i></a> #}
				{# {% endif %} #}
		</span>
		</div>
		<address>
			<strong>{{ cinema.name }}</strong><br>
			<i class="fas fa-map-marker-alt"></i> {{ cinema.address }}, {{ cinema.city }}<br>
			{% if cinema.phone %}
				<i class="fas fa-phone"></i> <a href="tel:{{ cinema.phone|replace({' ': ''}) }}">{{ cinema.phone }}</a><br>
			{% endif %}
			{% if cinema.email %}
				<i class="far fa-envelope"></i> <a href="mailto:{{ cinema.email }}">{{ cinema.email }}</a><br>
			{% endif %}
			<i class="fas fa-link"></i> <a href="{{ cinema.url }}">{{ cinema.url }}</a>
		</address>

		<a href="#cinemaMap" onClick="showCinemaMap();" id="cinemaMapButton" class="btn btn-danger collapsed" role="button" data-toggle="collapse" aria-expanded="false" aria-controls="cinemaMap">
			<i class="far fa-map"></i> <span id="cinemaMapButtonText">Zobrazit</span> kino na mapě
		</a><br><br>
	</div>

	<div id="cinemaMap" class="embed-responsive embed-responsive-16by9 collapse">
		<iframe id="cinemaMapIframe" class="embed-responsive-item" src="" allowfullscreen></iframe>
	</div>

	<div id="desktopTest" class="d-md-none d-lg-none"></div>
	<script>
		// shows map on load on desktops only
		// if($("#desktopTest").is(":hidden")) {
		// 	$("#cinemaMapButton").click();
		// }

		function showCinemaMap() {
			if($("#cinemaMap").css("display") === "block") {
				$("#cinemaMap").css("display", "none");
				$("#cinemaMapButtonText").text("Zobrazit");
				$("#cinemaMapIframe").attr("src", "");
			} else {
				$("#cinemaMap").css("display", "block");
				$("#cinemaMapButtonText").text("Skrýt");
				$("#cinemaMapIframe").attr("src", "https://www.google.com/maps/embed/v1/place?q={{ gmap|raw }}&key={{ gmapKey|raw }}");
			}
		}
	</script>
{% endblock %}

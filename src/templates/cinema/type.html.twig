{% extends "base.html.twig" %}

{% block title %}{{ type.translation.title }}{% endblock %}
{% block logo %}<div class="logo">{% if type.icon %}{{ type.iconTag|raw }}{% else %}<span>🎥</span>{% endif %}</div>{% endblock %}

{% block content %}
	<div class="lead">{{ type.translation.text|raw }}</div>
	
	<ul class="list-group">
		{% from "cinema/list.html.twig" import cinemaList %}
		{% for cinemaItem in cinemas %}
			{{ cinemaList(cinemaItem) }}
		{% endfor %}
	</ul><br>
	
	<nav>
		<ul class="pagination">
			<li class="page-item">
				<a href="{{ path("cinema_programme_" ~ type.ident) }}" class="page-link">{{ ("cinemas." ~ type.ident ~ ".programme")|trans }} <span aria-hidden="true">&rarr;</span></a>
			</li>
		</ul>
	</nav>
{% endblock %}

<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ meta.get('color') }}">
    <meta name="description" content="{{ meta.get('description') }}">
    <meta name="author" content="{{ meta.get('author') }}">
    {% if meta.get('robots') %}
    <meta name="robots" content="{{ meta.get('robots') }}">
    {% endif %}

    <title>{% block title %}{% endblock %} {{ meta.get('separator') }} {{ meta.get('name') }}</title>
{#	{% block importmap %}{{ importmap('app') }}{% endblock %}#}

    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
    <link rel="stylesheet" media="screen" href="{{ asset('styles/app.scss') }}?v={{ 'now'|date('U') }}">
    {# <link rel="stylesheet" media="print" href="{{ asset('print.css') }}"> #}

{#    <script src="{{ asset('www/js/scripts.js') }}?v={{ 'now'|date('U') }}"></script>#}

    <!-- Global site tag (gtag.js) - Google Analytics -->

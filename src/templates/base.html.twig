</head>

<body class="{% if app.request.attributes.get('_route') %}{{ app.request.attributes.get('_controller')|lower|replace({'\\\\': '-', '::': '-'}) }}{% endif %}">
<header id="header" class="navbar navbar-dark navbar-expand-md">
    <div class="container-fluid">
        {% include 'header.html.twig' %}
    </div>
</header>

<main id="main">
    <div class="container-fluid">
        <div class="row">
            <article class="col-12" id="content">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
                {% block content %}{% endblock %}
            </article>
        </div>
    </div>
</main>

{#<footer id="footer">#}

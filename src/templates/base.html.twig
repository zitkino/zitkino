<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="{{ meta.get('color') }}">
	<meta name="description" content="{{ meta.get('description') }}">
	<meta name="author" content="{{ meta.get('author') }}">
	{% if meta.get('robots') %}
		<meta name="robots" content="{{ meta.get('robots') }}">
	{% endif %}
	
	<title>{% block title %}{% endblock %} {{ meta.get('separator') }} {{ meta.get('name') }}</title>
	
	<link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@7.2.3/css/flag-icons.min.css">
	<link rel="stylesheet" media="screen" href="{{ asset('styles/app.scss') }}">
	{# <link rel="stylesheet" media="print" href="{{ asset('print.css') }}"> #}
	
	{{ importmap('app') }}
	
	<!-- Global site tag (gtag.js) - Google Analytics -->
	{#    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-80065906-1"></script> #}
	{#    <script> #}
	{#        window.dataLayer = window.dataLayer || []; #}
	
	{#        function gtag() { #}
	{#            dataLayer.push(arguments); #}
	{#        } #}
	{#        gtag('js', new Date()); #}
	
	{#        gtag('config', 'UA-80065906-1'); #}
	{#    </script> #}
</head>

<body class="{% if app.request.attributes.get('_route') %}{{ app.request.attributes.get('_controller')|lower|replace({'\\\\': '-', '::': '-'}) }}{% endif %}">
<nav id="navbar" class="navbar navbar-dark navbar-expand-md">
	<div class="container-fluid">
		{% include 'navbar.html.twig' %}
	</div>
</nav>

<main id="main">
	<div class="container-fluid">
		<header id="header" class="row">
			{% if block('header') is defined %}
				{{ block('header') }}
			{% else %}
				{% if block('logo') is defined %}
					<div class="col-12 {% if block('title') is defined %}col-md-4 col-xl-3 order-sm-2{% endif %} block-logo">
						{{ block('logo') }}
					</div>
				{% endif %}
				<div class="col-12 {% if block('logo') is defined %}col-md-8 col-xl-9 order-sm-1{% endif %} block-title">
					<section class="jumbotron jumbotron-header">
						<hgroup class="page-header">
							{% if block('pretitle') is defined %}
								<p class="pretitle">{{ block('pretitle') }}</p>
							{% endif %}
							{% if block('title') is defined %}
								<h1 class="title">{{ block('title') }}</h1>
							{% endif %}
							{% if block('subtitle') is defined %}
								<p class="subtitle">{{ block('subtitle') }}</p>
							{% endif %}
						</hgroup>
						{% if block('perex') is defined %}
							<div class="lead" id="perex">{{ block('perex') }}</div>
						{% endif %}
					</section>
				</div>
			{% endif %}
		</header>
		
		<article class="row">
			<div class="col-12" id="content">
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
					{% endfor %}
				{% endfor %}
				{% block content %}{% endblock %}
			</div>
		</article>
	</div>
</main>

{# <footer id="footer"> #}
{#    <div class="container-fluid"> #}
{#        {% include 'footer.html.twig' %} #}
{#    </div> #}
{# </footer> #}
</body>
</html>

<div class="home-map-box mb-5 overflow-hidden rounded-4 shadow-sm bg-white">
    <div class="row g-0">
        <div class="col-md-5 p-5 d-flex flex-column justify-content-center">
            <h6 class="text-danger fw-bold text-uppercase mb-3 small" style="letter-spacing: 1px;">{{ 'home.map.pretitle'|trans }}</h6>
            <h2 class="fw-bold mb-3">{{ 'home.map.title'|trans }}</h2>
            <p class="text-muted mb-4">{{ 'home.map.subtitle'|trans }}</p>
            <a href="{{ path('home_map') }}" class="text-danger text-decoration-none fw-bold">
                {{ 'home.map.open'|trans }} <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="col-md-7 bg-light position-relative" style="min-height: 300px; background-image: url('https://upload.wikimedia.org/wikipedia/commons/e/ea/BlankMap-World6.svg'); background-size: cover; background-position: center; opacity: 0.15;">
            {# Stylized markers to match the screenshot #}
            <div class="position-absolute" style="top: 30%; left: 40%;">
                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; border: 2px solid white;">
                    <i class="bi bi-film small"></i>
                </div>
                <div class="bg-white px-2 py-1 shadow-sm rounded mt-1 small fw-bold">Kino Scala</div>
            </div>
            <div class="position-absolute" style="top: 60%; left: 60%;">
                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 32px; height: 32px; border: 2px solid white;">
                    <i class="bi bi-film small"></i>
                </div>
                <div class="bg-white px-2 py-1 shadow-sm rounded mt-1 small fw-bold">Kino Art</div>
            </div>
        </div>
    </div>
</div>

<style>
    .home-map-box {
        transition: transform 0.3s ease;
    }
    .home-map-box:hover {
        transform: translateY(-5px);
    }
</style>
